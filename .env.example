# Leave DATABASE_URL unset to run on the embedded PGlite database in .ledger-data
DATABASE_URL=
LEDGER_DATA_DIR=.ledger-data

# Model provider: simulator (default, no key needed) | anthropic
MODEL_PROVIDER=simulator
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Inngest Cloud. Unset means the local dispatcher runs the same functions in process.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Slack. Unset means the chat surface is stubbed and posts land in the ledger only.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Google Docs service account JSON, one line. Unset means the docs simulator is used.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DOC_TEMPLATE_ID=

# Clerk. Unset means the dev auth provider signs you in as the seeded manager.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
